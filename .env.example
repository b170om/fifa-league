# Public read key. Safe to expose in the browser; RLS allows select only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server only. Never prefix with NEXT_PUBLIC. Used for inserts, edits, and the rating replay.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional. On Vercel, AI Gateway authenticates with OIDC and this can stay empty.
# Locally, set a key from the Vercel AI Gateway dashboard if you want model-written recaps.
# AI_GATEWAY_MODEL overrides the default (google/gemini-3.5-flash). Use an id from
# https://ai-gateway.vercel.sh/v1/models
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
